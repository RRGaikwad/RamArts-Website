rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Replace REPLACE_WITH_ADMIN_UID with the same admin UID used in firestore.rules
    function isAdmin() {
      return request.auth != null
        && request.auth.uid in [
          'el6wul7NedZF5FNBK4ZGVUlht4Z2'
        ];
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 8 * 1024 * 1024;
    }

    function isVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size < 100 * 1024 * 1024;
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (isImage() || isVideo());
    }

    match /updates/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isImage();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
